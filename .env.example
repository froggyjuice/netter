# 로컬에서 Supabase까지 연결해 테스트할 때만 .env 로 복사해서 채우세요.
# (비워두면 로컬 개발 서버는 .data/scores.json 파일에 점수를 저장합니다)
#
# 주의: SUPABASE_SERVICE_KEY 는 서버 전용 비밀 키입니다.
#       절대 GitHub에 올리거나 VITE_ 접두사를 붙이지 마세요. (Vercel 환경변수에만 등록)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
#
# 동아리 허브 로그인 (배포에서는 꼭 넣기, 로컬은 비워도 개발용 값으로 동작)
# SESSION_SECRET: 로그인 토큰 서명용 긴 무작위 문자열 (예: 40자 이상)
# ADMIN_CODE   : 운영진 화면(회원 연락처가 보이는 곳)에 들어갈 때 쓰는 코드 (로컬 기본값: dev)
SESSION_SECRET=
ADMIN_CODE=
